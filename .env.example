# Local development only. Copy to .env (git-ignored) to override defaults.
# Every value here is a safe placeholder; never put a real credential, key or merchant ID here.

# PostgreSQL container (docker-compose.yml). Local-only credentials.
POSTGRES_USER=emi_copilot
POSTGRES_PASSWORD=emi_copilot_local_only
POSTGRES_DB=emi_copilot
POSTGRES_HOST_PORT=55432

# Backend application settings (backend/src/emi_copilot/config/settings.py).
# pragma: allowlist nextline secret
DATABASE_URL=postgresql+psycopg://emi_copilot:emi_copilot_local_only@localhost:55432/emi_copilot
# mock (default) or paytm. paytm fails at startup until Paytm credentials exist (ADR 0004), and
# also while the customer's phone number and consent codes have only Mock sources [Verify with Paytm].
PAYMENT_GATEWAY_MODE=mock
# A payment link still being created after twice (connect + read timeout), 26 s by default, is
# treated as OUTCOME_UNKNOWN when its Idempotency-Key is replayed; it is never re-sent.
PAYMENT_GATEWAY_CONNECT_TIMEOUT_IN_SECONDS=3.0
PAYMENT_GATEWAY_READ_TIMEOUT_IN_SECONDS=10.0
# Retries apply to idempotent reads only; create-link calls are never retried (ADR 0005).
# Attempts: 1 to 10. Full-jitter backoff: uniform(0, min(max delay, base delay * 2^retry)).
PAYMENT_GATEWAY_RETRY_MAX_ATTEMPTS=3
PAYMENT_GATEWAY_RETRY_BASE_DELAY_IN_SECONDS=0.2
PAYMENT_GATEWAY_RETRY_MAX_DELAY_IN_SECONDS=2.0
# Consecutive failures that open the circuit, and how long it stays open before one trial call.
PAYMENT_GATEWAY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
PAYMENT_GATEWAY_CIRCUIT_BREAKER_OPEN_DURATION_IN_SECONDS=30.0
# Mock adapter webhook signing secret (at least 32 characters). Empty means a random secret is
# drawn once per process, so simulated webhooks are signed by the running server only.
MOCK_GATEWAY_WEBHOOK_SIGNING_SECRET=
# Paytm adapter, used only when PAYMENT_GATEWAY_MODE=paytm. Leave the credentials empty until
# staging keys exist; never commit real values. Empty means not set.
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
# Our public https webhook URL, sent to Paytm as statusCallbackUrl. Empty means none is sent.
PAYTM_WEBHOOK_CALLBACK_URL=
# Unset base URLs get Paytm's staging hosts from the gateway factory (paytm_api_definitions.py,
# ADR 0002, ADR 0011). Production hosts have no default; set all three explicitly for production.
# PAYTM_EMI_SUBVENTION_BASE_URL=
# PAYTM_PAYMENT_LINK_BASE_URL=
# PAYTM_TRANSACTION_STATUS_BASE_URL=
# Merchant device pairing. A paired counter device's bearer token lifetime (60 to 604800;
# 12 hours by default), and how many pairing requests one client address may send per window.
MERCHANT_ACCESS_TOKEN_LIFETIME_IN_SECONDS=43200
MERCHANT_PAIRING_RATE_LIMIT_MAX_REQUESTS=10
MERCHANT_PAIRING_RATE_LIMIT_WINDOW_IN_SECONDS=60
# Payment links and payment status checks each shop may make per window (in memory, per process).
MERCHANT_PAYMENT_RATE_LIMIT_MAX_REQUESTS=60
MERCHANT_PAYMENT_RATE_LIMIT_WINDOW_IN_SECONDS=60
# Gateway webhooks one client address may send per window: generous, so real retries get through.
PAYMENT_WEBHOOK_RATE_LIMIT_MAX_REQUESTS=600
PAYMENT_WEBHOOK_RATE_LIMIT_WINDOW_IN_SECONDS=60
# Customer QR codes. HMAC-SHA256 signing secret, at least 32 characters. Empty means a random
# secret is drawn once per process in Mock mode (QR codes stop working after a restart, with a
# warning in the log); PAYMENT_GATEWAY_MODE=paytm refuses to start without it.
CUSTOMER_QR_SIGNING_SECRET=
# How long one QR code works (60 to 86400; 15 minutes by default); it can be re-issued.
CUSTOMER_QR_TOKEN_LIFETIME_IN_SECONDS=900
# Where the QR code sends the customer's phone; the token is added as the #t= fragment.
CUSTOMER_WEB_BASE_URL=http://localhost:5174
# A sale still CHOOSING this long after it started expires (60 to 86400; 1 hour by default).
SALE_CHOOSING_EXPIRY_IN_SECONDS=3600
# Live sale status stream (GET /api/v1/sales/events): unread messages one stream may hold before
# its backlog is replaced by one "resync" message (1 to 10000).
SALE_EVENT_STREAM_MAXIMUM_QUEUED_MESSAGES=100
# Seconds between ": heartbeat" comments on a quiet stream (above 0, at most 300).
SALE_EVENT_STREAM_HEARTBEAT_INTERVAL_IN_SECONDS=15
# MockCustomerSimulator: demo-only endpoints (not in openapi.json) that play the customer agreeing
# to a plan and paying a Mock link, announced in the startup log. true is refused in paytm mode.
MOCK_CUSTOMER_SIMULATOR_ENABLED=false
# Customer sessions and consent one-time codes (ADR 0022, demo values). A customer session lasts
# 30 minutes (60 to 86400). A code lasts 5 minutes (30 to 3600), allows 3 attempts (1 to 10) and
# can be resent after 30 seconds (1 to 600, below the code lifetime).
CUSTOMER_SESSION_LIFETIME_IN_SECONDS=1800
CONSENT_OTP_LIFETIME_IN_SECONDS=300
CONSENT_OTP_MAXIMUM_ATTEMPTS=3
CONSENT_OTP_RESEND_WAIT_IN_SECONDS=30
# MockConsentOtpSenderAdapter sends nothing, so the customer types this fixed demo code (6 digits).
# pragma: allowlist nextline secret
MOCK_CONSENT_OTP_CODE=123456
# MockSyntheticFinancialProfileAdapter (demo only): the synthetic profile every comfort check
# reads. standard (default) is the design's customer (inflow 30,000 rupees, existing EMIs 8,000);
# risky is its second customer (inflow 20,000 rupees, plan B 59.3%), to show the Risky band.
MOCK_FINANCIAL_PROFILE=standard
# HMAC-SHA256 key (at least 32 characters) for the customer's phone hash and code hashes. Empty
# means a random key is drawn once per process in Mock mode (with a warning in the log);
# PAYMENT_GATEWAY_MODE=paytm refuses to start without it.
CUSTOMER_PHONE_HASH_SECRET=
# Customer rate limits (in memory, per process; 429 with Retry-After). QR exchanges per client
# address per window; one-time code requests and consent attempts per client address and
# customer session per window.
CUSTOMER_SESSION_START_RATE_LIMIT_MAX_REQUESTS=20
CUSTOMER_SESSION_START_RATE_LIMIT_WINDOW_IN_SECONDS=60
CONSENT_OTP_REQUEST_RATE_LIMIT_MAX_REQUESTS=5
CONSENT_OTP_REQUEST_RATE_LIMIT_WINDOW_IN_SECONDS=600
CUSTOMER_CONSENT_RATE_LIMIT_MAX_REQUESTS=10
CUSTOMER_CONSENT_RATE_LIMIT_WINDOW_IN_SECONDS=600
# The shop's calendar for "today" on the counter list and the report periods (IANA name).
REPORTING_TIME_ZONE=Asia/Kolkata
LOG_LEVEL=INFO

# AI components (Layer 4; backend/src/emi_copilot/config/ai_settings.py). Each capability is
# off (templates only, no voice), mock (labelled MockSpeechAdapter / MockExplanationTextAdapter,
# the default) or sarvam. sarvam refuses to start without SARVAM_API_KEY (ADR 0004 style).
SPEECH_PROVIDER_MODE=mock
EXPLANATION_TEXT_PROVIDER_MODE=mock
# sequential (plain Python, the default) or langgraph (needs the optional "ai" extra).
AI_FLOW_RUNNER=sequential
# MockExplanationTextAdapter only: correct, wrong_number (one digit changed, so the number audit
# falls back to the template) or unavailable (always fails, so the template is shown).
MOCK_AI_TEXT_BEHAVIOUR=correct
# Your own Sarvam API subscription key. Leave empty here; put the real key only in .env, which is
# git-ignored. It is never logged. Empty means not set.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
# Per capability: connect and read timeouts in seconds, consecutive failures that open its
# circuit, and how long it stays open. Calls are never retried (they cost credits; templates exist).
SARVAM_SPEECH_TO_TEXT_CONNECT_TIMEOUT_IN_SECONDS=3.0
SARVAM_SPEECH_TO_TEXT_READ_TIMEOUT_IN_SECONDS=10.0
SARVAM_SPEECH_TO_TEXT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
SARVAM_SPEECH_TO_TEXT_CIRCUIT_BREAKER_OPEN_DURATION_IN_SECONDS=30.0
SARVAM_TEXT_TO_SPEECH_CONNECT_TIMEOUT_IN_SECONDS=3.0
SARVAM_TEXT_TO_SPEECH_READ_TIMEOUT_IN_SECONDS=10.0
SARVAM_TEXT_TO_SPEECH_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
SARVAM_TEXT_TO_SPEECH_CIRCUIT_BREAKER_OPEN_DURATION_IN_SECONDS=30.0
SARVAM_CHAT_CONNECT_TIMEOUT_IN_SECONDS=3.0
SARVAM_CHAT_READ_TIMEOUT_IN_SECONDS=6.0
SARVAM_CHAT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
SARVAM_CHAT_CIRCUIT_BREAKER_OPEN_DURATION_IN_SECONDS=30.0
SARVAM_SPEECH_TO_TEXT_MODEL=saaras:v4
SARVAM_TEXT_TO_SPEECH_MODEL=bulbul:v3
# sarvam-105b-conversations (the owner chose the 105B family): sarvam-105b spent its whole token
# budget on hidden reasoning in the 2026-11-15 smoke check; the conversations model answered in
# 0.3 s.
SARVAM_CHAT_MODEL=sarvam-105b-conversations
# bulbul:v3 speaker per language [Verify that it reads Tamil and English well].
SARVAM_TEXT_TO_SPEECH_ENGLISH_SPEAKER=shubh
SARVAM_TEXT_TO_SPEECH_TAMIL_SPEAKER=shubh
# Chat temperature (0 to 2, written as a decimal string), max tokens (1 to 4000) and reasoning
# effort (low, medium or high only; "none" is refused with 400, verified 2026-11-15).
SARVAM_CHAT_TEMPERATURE=0.2
SARVAM_CHAT_MAX_TOKENS=600
SARVAM_CHAT_REASONING_EFFORT=low
# Prices in rupees, for cost estimates only [Verify against Sarvam's current price list]. The
# chat prices are sarvam-105b's: sarvam-105b-conversations is not on the pricing page [Verify].
SARVAM_SPEECH_TO_TEXT_PRICE_IN_RUPEES_PER_MINUTE=0.49
SARVAM_TEXT_TO_SPEECH_PRICE_IN_RUPEES_PER_THOUSAND_CHARACTERS=3.00
SARVAM_CHAT_INPUT_PRICE_IN_RUPEES_PER_MILLION_TOKENS=15
SARVAM_CHAT_OUTPUT_PRICE_IN_RUPEES_PER_MILLION_TOKENS=60
# Demo limits: one recording at most 512 KiB (1024 to 5242880 bytes) and 15 s (1 to 29), and AI
# calls one customer session may make per window (in memory, per process).
SPEECH_UPLOAD_MAX_BYTES=524288
SPEECH_MAX_RECORDING_SECONDS=15
AI_SESSION_RATE_LIMIT_MAX_REQUESTS=10
AI_SESSION_RATE_LIMIT_WINDOW_IN_SECONDS=60

# Demo seed (make seed). The demo shop RAVI-0193's pairing PIN: exactly 6 digits, chosen by you.
# Empty means not set, and the seed refuses to run; no PIN is ever written in code.
DEMO_MERCHANT_PIN=

# Local development server (make dev).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
