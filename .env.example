# Local development only. Copy to .env (git-ignored) to override defaults.
# Every value here is a safe placeholder; never put a real credential, key or merchant ID here.

# PostgreSQL container (docker-compose.yml). Local-only credentials.
POSTGRES_USER=emi_copilot
POSTGRES_PASSWORD=emi_copilot_local_only
POSTGRES_DB=emi_copilot
POSTGRES_HOST_PORT=55432

# Backend application settings (backend/src/emi_copilot/config/settings.py).
# pragma: allowlist nextline secret
DATABASE_URL=postgresql+psycopg://emi_copilot:emi_copilot_local_only@localhost:55432/emi_copilot
# mock (default) or paytm. paytm fails at startup until Paytm credentials exist (ADR 0004).
PAYMENT_GATEWAY_MODE=mock
PAYMENT_GATEWAY_CONNECT_TIMEOUT_IN_SECONDS=3.0
PAYMENT_GATEWAY_READ_TIMEOUT_IN_SECONDS=10.0
# Retries apply to idempotent reads only; create-link calls are never retried (ADR 0005).
# Attempts: 1 to 10. Full-jitter backoff: uniform(0, min(max delay, base delay * 2^retry)).
PAYMENT_GATEWAY_RETRY_MAX_ATTEMPTS=3
PAYMENT_GATEWAY_RETRY_BASE_DELAY_IN_SECONDS=0.2
PAYMENT_GATEWAY_RETRY_MAX_DELAY_IN_SECONDS=2.0
# Consecutive failures that open the circuit, and how long it stays open before one trial call.
PAYMENT_GATEWAY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
PAYMENT_GATEWAY_CIRCUIT_BREAKER_OPEN_DURATION_IN_SECONDS=30.0
LOG_LEVEL=INFO

# Local development server (make dev).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
