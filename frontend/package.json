{
  "name": "emi-copilot-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^20.19.0"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "typecheck": "tsc --noEmit -p . && pnpm --recursive --parallel run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "generate:api": "pnpm --filter @emi-copilot/api-client run generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "20.19.43",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
